# GitHub App Configuration
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_private_key_here\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# GitHub OAuth Configuration (optional)
OAUTH_GITHUB_CLIENT_ID=your_oauth_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_oauth_client_secret

# Security Configuration
ALLOWED_ORGS=org1,org2,org3
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASS=secure_password

# Application Configuration
CONTRIBUTOR_WINDOW_DAYS=90

# Frontend Configuration
VITE_GITHUB_APP_INSTALL_URL=https://github.com/apps/your-app-name/installations/new